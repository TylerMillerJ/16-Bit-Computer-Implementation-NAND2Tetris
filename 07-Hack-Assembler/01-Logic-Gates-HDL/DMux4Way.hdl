/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 0 0
 *                [0, in, 0, 0] if sel = 0 1
 *                [0, 0, in, 0] if sel = 1 0
 *                [0, 0, 0, in] if sel = 1 1
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    DMux(in=in, sel=sel[0], a=aVSc, b=bVSd);
    DMux(in=aVSc, sel=sel[1], a=a, b=c);
    DMux(in=bVSd, sel=sel[1], a=b, b=d);
}