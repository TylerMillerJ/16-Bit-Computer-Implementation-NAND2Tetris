/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in=previousInput, out=incrementedInput);
    Mux16(a=previousInput, b=incrementedInput, sel=inc, out=incrementedDecision);
    
    Mux16(a=incrementedDecision, b=in, sel=load, out=loadDecisionOutput);

    Mux16(a=loadDecisionOutput, b=false, sel=reset, out=resetDecisionOutput);
    Register(in=resetDecisionOutput, load=true, out=out, out=previousInput);


}