// Parts Implementation Completed by Tyler Miller

/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:

    DMux8Way(in=load, sel=address[0..2], a=firstRam512Load, b=secondRam512Load, c=thirdRam512Load, d=fourthRam512Load, e=fifthRam512Load, f=sixthRam512Load, g=seventhRam512Load, h=eightRam512Load);
    RAM512(in=in, load=firstRam512Load, address=address[3..11], out=outFirstRam512Chip);
    RAM512(in=in, load=secondRam512Load, address=address[3..11], out=outSecondRam512Chip);
    RAM512(in=in, load=thirdRam512Load, address=address[3..11], out=outThirdRam512Chip);
    RAM512(in=in, load=fourthRam512Load, address=address[3..11], out=outFourthRam512Chip);
    RAM512(in=in, load=fifthRam512Load, address=address[3..11], out=outFifthRam512Chip);
    RAM512(in=in, load=sixthRam512Load, address=address[3..11], out=outSixthRam512Chip);
    RAM512(in=in, load=seventhRam512Load, address=address[3..11], out=outSeventhRam512Chip);
    RAM512(in=in, load=eightRam512Load, address=address[3..11], out=outEightRam512Chip);

    Mux8Way16(a=outFirstRam512Chip, b=outSecondRam512Chip, c=outThirdRam512Chip, d=outFourthRam512Chip , e=outFifthRam512Chip, f=outSixthRam512Chip, g=outSeventhRam512Chip, h=outEightRam512Chip, sel=address[0..2], out=out);
}