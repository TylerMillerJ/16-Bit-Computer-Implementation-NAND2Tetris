/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[16];          // address of next instruction

    PARTS:
    //The first Mux input is (the new instruction && previous output from the ALU)
    //If the Operation Code stored at instruction[15] is equal to 0; then the instruction is an A instruction, and will be selected
    //Otherwise the previous ALU output is selected
    //Next, the choice is wired to the A register
    Mux16(a=instruction, b=previousOutputFromALU, sel=instruction[15], out=MuxOutputIsInputForRegisterA);

    //An A-instruction always loads A; a C-instruction loads A only if dest bit d1 (instruction[5]) is set
    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=isCInstructionDestA);
    Or(a=isAInstruction, b=isCInstructionDestA, out=loadA);

    //instruction[5] is the destination control bit for Register A in the HACK Machine Language Specification
    ARegister(in=MuxOutputIsInputForRegisterA, load=loadA, out=outputOfRegisterA, out[0..14]=addressM);

    //The output of the following Mux chip selects whether the ALU will receive the data from register A or M
    //HACK Machine Language specification outlines that instruction[12] is the selector bit for this decision
    Mux16(a=outputOfRegisterA, b=inM, sel=instruction[12], out=MuxRegisterAM);

    //instruction[4] is the destination control bit for Register D in the HACK Machine Language Specification
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=previousOutputFromALU, load=loadD, out=registerD);

    //The ALU received input from register A or M (Mux selection), and from Register D to perform operations
    //The Hack Machine Language outlines instruction[6..11] for the instruction inputs to the ALU
    //ALU output is fanned out to multiple destinations
    //ZR and NG encode if the output is 0 (ZR) or negative (NG)
    ALU(x=registerD, y=MuxRegisterAM, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=previousOutputFromALU, out=outM, zr=zrOutput, ng=ngOutput);

    //instruction[3] specifies to write a value to memory using writeM output directed at the addressM
    //Valid only on a C-instruction
    And(a=instruction[15], b=instruction[3], out=writeM);

    //The PC should load a jumped-to address if the C-instruction's jump bits are satisfied
    //Evaluating the conditional GOTO/JMP instructions, JMP in the following conditions:
    And(a=ngOutput, b=instruction[2], out=ngJMP);
    And(a=zrOutput, b=instruction[1], out=zrJMP);
    Not(in=ngOutput, out=ngNot);
    Not(in=zrOutput, out=zrNot);
    And(a=ngNot, b=zrNot, out=isPositive);
    And(a=isPositive, b=instruction[0], out=gtJMP);

    Or(a=ngJMP, b=zrJMP, out=jumpTmp);
    Or(a=jumpTmp, b=gtJMP, out=jumpCondition);
    And(a=instruction[15], b=jumpCondition, out=loadBit);

    //The PC should increment whenever it isn't loading a jump target
    Not(in=loadBit, out=instructionsToIncrement);

    PC(in=outputOfRegisterA, load=loadBit, inc=instructionsToIncrement, reset=reset, out=pc);
}